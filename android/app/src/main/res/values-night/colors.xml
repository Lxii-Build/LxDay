<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      启动帧底色。与 miuix colorScheme.background 对齐（浅 #F7F7F7 / 暗 #0F0F0F），
      让"冷启动 → Compose 首帧"之间没有色差跳变（Q4=A）。
      card_bg 是通知卡片用色（带品牌色调），拿它当窗口底色会闪一下粉/紫。
    -->
    <color name="launch_bg">#0F0F0F</color>
    <!-- 深色（语义反转扩展）：通知卡片跟随系统 values-night -->
    <color name="card_bg">#1A1720</color>
    <color name="card_text">#ECE8F0</color>
    <color name="card_text_secondary">#A9A0B4</color>
    <color name="card_border">#1AFFFFFF</color>

    <!-- 状态语义色保持可读 -->
    <color name="status_charging">#66BB6A</color>
    <color name="status_low_battery">#EF5350</color>
    <color name="status_screen_on">#42A5F5</color>
    <color name="status_music">#AB47BC</color>
    <color name="status_theme">#78909C</color>
</resources>
