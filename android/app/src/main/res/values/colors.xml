<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      启动帧底色。与 miuix colorScheme.background 对齐（浅 #F7F7F7 / 暗 #0F0F0F），
      让"冷启动 → Compose 首帧"之间没有色差跳变（Q4=A）。
      card_bg 是通知卡片用色（带品牌色调），拿它当窗口底色会闪一下粉/紫。
    -->
    <color name="launch_bg">#F7F7F7</color>
    <!-- 浅色（默认）：MilkGlass 规范色板 -->
    <color name="card_bg">#F6EEF2</color>
    <color name="card_text">#5B5560</color>
    <color name="card_text_secondary">#8A8290</color>
    <color name="card_border">#8CFFFFFF</color>

    <!-- Launcher 图标背景（品牌蓝，统一主色 #277AF7） -->
    <color name="ic_launcher_background">#277AF7</color>

    <!-- 状态语义色（深浅两套通用） -->
    <color name="status_charging">#4CAF50</color>
    <color name="status_low_battery">#F44336</color>
    <color name="status_screen_on">#2196F3</color>
    <color name="status_music">#9C27B0</color>
    <color name="status_theme">#607D8B</color>
</resources>
