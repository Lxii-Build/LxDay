# 林曦日记 · Docker Compose 环境变量示例（学 hl6：全部 env 驱动）
# 复制为 .env（与 docker-compose.yml 同目录，勿提交），填好后：
#   docker compose pull && docker compose up -d
# 离线：下载工作流镜像 tar → gunzip -c lxday-image.tar.gz | docker load → docker compose up -d

# 镜像地址（默认 GHCR latest）。离线导入或本地构建后可改成对应本地标签。
LXDAY_IMAGE=ghcr.io/lxii-build/lxday:latest

# 对外端口（容器内固定 7740）。宝塔反代目标即 127.0.0.1:<APP_PORT>。
APP_PORT=7740

# JWT_SECRET：登录令牌签名密钥（必填）。生成：openssl rand -hex 32
JWT_SECRET=please-generate-a-long-random-secret

# APP_KEY：通讯密钥（X-App-Key），需与安卓构建注入的一致；留空则禁用校验。
APP_KEY=
