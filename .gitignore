# Claude Code 内部文件（不属项目）
.agents/
.claude/
agent/
skills-lock.json

# Go
server/server
server/uploads/
*.exe
# 内嵌后台产物：仓库只保留占位 index.html，真实 dist 由 Dockerfile 构建时覆盖。
# 本地为了跑真实后台会把 admin/dist 拷进来，绝不能提交（139 个构建产物污染仓库）。
server/webdist/*
!server/webdist/index.html

# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab
dist/

# 凭据与本地配置
*.pem
*.key
config.yaml
!config.example.yaml
.env
!.env.example
*.jks
*.keystore
# 签名密钥库：默认全部忽略，只放行固定的 debug 密钥库。
# debug 密钥按安卓惯例是公开的（口令 android），提交进仓库是为了让本地与 CI 的
# debug APK 签名一致、可互相覆盖安装。
# 正式密钥 lxday-release.p12 绝不入库，只走 GitHub Secret ANDROID_KEYSTORE_BASE64。
*.p12
!android/keystore/lxday-debug.p12
*.p12.base64
release-store-password.txt

# 系统
.DS_Store
Thumbs.db
